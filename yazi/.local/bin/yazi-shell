#!/usr/bin/env bash

LAST_DIR_FILE="$HOME/.local/state/yazi/last-dir"
mkdir -p "$(dirname "$LAST_DIR_FILE")"

LAST_DIR=$(cat "$LAST_DIR_FILE" 2>/dev/null || echo "$HOME")
cd "$LAST_DIR"

function y() {
  local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
  yazi "$@" --cwd-file="$tmp"
  IFS= read -r -d '' cwd <"$tmp"
  [ -n "$cwd" ] && [ "$cwd" != "$PWD" ] && builtin cd -- "$cwd"
  rm -f -- "$tmp"
}

trap 'pwd > "$LAST_DIR_FILE"' EXIT

y

exec bash
