// Monitor configuration.
// Both are physically 3840x2160 (4K); scale 1.5 on both keeps UI text/elements
// a normal size instead of tiny (was previously not applying at all: the old
// connector names here, "DP-1"/"eDP-1", didn't match this machine's real
// outputs "DP-3"/"Unknown-1", so niri fell back to its own auto-scale, which
// picked scale 1 for the Samsung panel — that's the "super small" apps like
// Steam/Plasticity were seeing).

output "DP-3" {
    mode "3840x2160@59.997"
    scale 1.5
    position x=0 y=0
}

output "Unknown-1" {
    mode "3840x2160@60.000"
    scale 1.5
    position x=2560 y=0
}
