// Include monitor configuration generated by nwg-displays
include "monitor.kdl"

spawn-at-startup "noctalia"

xwayland-satellite {
    path "xwayland-satellite"
}

input {
    focus-follows-mouse
    keyboard {
        xkb {
            layout "us,ua,sk"
        }
        numlock
    }

    touchpad {
        tap
        natural-scroll
    }

    mouse {
        accel-profile "flat"
    }
}

layout {
    background-color "transparent"
    gaps 7
    
    focus-ring {
        width 2
    }

    struts {
        left 5
        right 5
        top 5
        bottom 5
    }
}

prefer-no-csd

window-rule {
    geometry-corner-radius 7
    clip-to-geometry true
}

window-rule {
    match app-id=r#"^ncspot$"#
    open-floating true
    default-column-width { fixed 800; }
    default-window-height { fixed 400; }
    default-floating-position x=10 y=10 relative-to="bottom-right"
}

// Put swaybg inside the overview backdrop.
layer-rule {
    place-within-backdrop true
}

binds {
    // Basic
    Mod+Return { spawn "kitty"; }
    Mod+Space { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Mod+Q { close-window; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+Alt+F { toggle-window-floating; }
    Mod+Ctrl+F { switch-focus-between-floating-and-tiling; }
    Mod+C { center-column; }
    Mod+G { toggle-column-tabbed-display; }
    Mod+M { spawn "kitty" "--class" "ncspot" "-e" "ncspot"; }


    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }

    // Finer height adjustments when in column with other windows.
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }


    // Focus (Vim motions)
    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    Mod+K { focus-window-up; }
    Mod+J { focus-window-down; }

    // Moving Windows (Vim motions)
    Mod+Shift+H { move-column-left; }
    Mod+Shift+L { move-column-right; }
    Mod+Shift+K { move-window-up; }
    Mod+Shift+J { move-window-down; }

    Mod+Alt+H  { consume-window-into-column; }
    Mod+Alt+L { expel-window-from-column; }
    Mod+Ctrl+H  { consume-or-expel-window-left; }
    Mod+Ctrl+L { consume-or-expel-window-right; }

    // Workspace Switching
    Mod+1 { focus-workspace "w1"; }
    Mod+2 { focus-workspace "w2"; }
    Mod+3 { focus-workspace "w3"; }
    Mod+4 { focus-workspace "w4"; }
    Mod+5 { focus-workspace "w5"; }

    // Move to Workspace
    Mod+Shift+1 { move-column-to-workspace "w1"; }
    Mod+Shift+2 { move-column-to-workspace "w2"; }
    Mod+Shift+3 { move-column-to-workspace "w3"; }
    Mod+Shift+4 { move-column-to-workspace "w4"; }
    Mod+Shift+5 { move-column-to-workspace "w5"; }

    // Media
    // Mod+Alt+J { spawn "playerctl" "previous"; }
    // Mod+Alt+L { spawn "playerctl" "next"; }
    // Mod+Alt+K { spawn "playerctl" "play-pause"; }

    // Programs
    Mod+D { spawn "vesktop"; }
    // Custom Execs
    Mod+E { spawn "kitty" "-e" "fish" "-c" "y"; }
    Mod+B { spawn "zen"; }


    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05+ -l 1.0"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05-"; }
    XF86AudioMute        allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute     allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }

    // Example media keys mapping using playerctl.
    // This will work with any MPRIS-enabled media player.
    XF86AudioPlay        allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioPause       allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioStop        allow-when-locked=true { spawn-sh "playerctl stop"; }
    XF86AudioPrev        allow-when-locked=true { spawn-sh "playerctl previous"; }
    XF86AudioNext        allow-when-locked=true { spawn-sh "playerctl next"; }

    XF86MonBrightnessUp allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "+5%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "5%-"; }

    Shift+XF86MonBrightnessUp allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "+1%"; }
    Shift+XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "1%-"; }
    // Mod+Alt+W { spawn "noctalia-shell" "ipc" "call" "wifi" "togglePanel"; }
    // Mod+Alt+B { spawn "noctalia-shell" "ipc" "call" "bluetooth" "togglePanel"; }

    Mod+Escape { spawn "noctalia" "msg" "panel-toggle" "session"; }
    Mod+V { spawn "noctalia" "msg" "panel-toggle" "clipboard"; }
    Mod+Tab { spawn "noctalia" "msg" "panel-toggle" "control-center"; }
    Mod+Shift+W { spawn "noctalia" "msg" "panel-toggle" "control-center" "network"; }
    Mod+Shift+B { spawn "noctalia" "msg" "panel-toggle" "control-center" "bluetooth"; }
    Mod+Shift+A { spawn "noctalia" "msg" "panel-toggle" "control-center" "audio"; }
    Mod+Shift+D { spawn "noctalia" "msg" "panel-toggle" "control-center" "monitor"; }
    Mod+Shift+N { spawn "noctalia" "msg" "panel-toggle" "control-center" "notifications"; }
    Mod+Shift+I { spawn "noctalia" "msg" "settings-open"; }

    Alt+Tab { spawn "noctalia" "msg" "window-switcher"; }
    Ctrl+Mod+Space { spawn "noctalia" "msg" "wallpaper-random"; }
    Ctrl+Shift+Mod+Space { spawn "noctalia" "msg" "panel-toggle" "wallpaper"; }

    // Touchpad Toggle
    XF86TouchpadToggle { spawn "sh" "-c" "~/.local/bin/toggle-touchpad.sh"; }

    // Screenshot / Snipping Tool (region select)
    Mod+Shift+S { spawn "noctalia" "msg" "screenshot-region"; }
}

workspace "w1"
workspace "w2"
workspace "w3"
workspace "w4"
workspace "w5"

include "./noctalia.kdl"

