layout {

    focus-ring {
        active-color   "#e9b3ff"
        inactive-color "#131313"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#e9b3ff"
        inactive-color "#131313"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#e9b3ff"
        inactive-color "#63307c"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#e9b3ff80"
    }
}

recent-windows {
    highlight {
        active-color "#e9b3ff"
        urgent-color "#ffb4ab"
    }
}
